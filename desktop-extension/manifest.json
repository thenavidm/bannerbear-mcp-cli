{
  "manifest_version": "0.2",
  "name": "bannerbear",
  "display_name": "Bannerbear MCP Server & CLI",
  "version": "3.0.1",
  "description": "Bannerbear V5 tools with confirmed mutations and private workspace keys.",
  "long_description": "75 shared tools: 33 reads/helpers and 42 confirmed mutations. Current V5 templates, renders, workflows, assets and private signing-key delivery.",
  "author": {
    "name": "Navid Moazzez",
    "url": "https://navid.me"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/thenavidm/bannerbear-mcp-cli"
  },
  "homepage": "https://navid.me/mcp-servers/bannerbear",
  "documentation": "https://github.com/thenavidm/bannerbear-mcp-cli/blob/main/INSTALL.md",
  "support": "https://github.com/thenavidm/bannerbear-mcp-cli/issues",
  "license": "AGPL-3.0-or-later",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "cli",
    "command-line-tool",
    "bannerbear",
    "image-generation",
    "video-generation",
    "templates",
    "workflows",
    "batch-rendering",
    "api-key",
    "codex",
    "claude-code",
    "claude-desktop",
    "cursor",
    "ai-agents",
    "typescript",
    "desktop-extension",
    "private-accounts",
    "json",
    "mutation-approval",
    "write-safety",
    "gemini-cli",
    "windsurf",
    "open-source",
    "creator-workflows",
    "signing-key",
    "read-only",
    "schema-validation"
  ],
  "server": {
    "type": "node",
    "entry_point": "server/index.js",
    "mcp_config": {
      "command": "node",
      "args": [
        "${__dirname}/server/index.js"
      ],
      "env": {
        "BANNERBEAR_API_KEY": "${user_config.api_key}",
        "BANNERBEAR_TOKEN_FILE": "${user_config.token_file}",
        "BANNERBEAR_READ_ONLY": "${user_config.read_only}",
        "BANNERBEAR_ALLOW_DESTRUCTIVE": "${user_config.allow_destructive}"
      }
    }
  },
  "user_config": {
    "token_file": {
      "type": "string",
      "title": "Private token-only file",
      "description": "Absolute owner-private V5 key file; overrides the environment key.",
      "required": false
    },
    "read_only": {
      "type": "boolean",
      "title": "Read only",
      "description": "Hide and refuse all 42 mutations, including renders, uploads and reviewed batch submission.",
      "default": false,
      "required": false
    },
    "api_key": {
      "type": "string",
      "title": "Bannerbear V5 workspace key",
      "description": "Private Bannerbear V5 workspace key; leave empty when using a token file.",
      "required": false,
      "sensitive": true
    },
    "allow_destructive": {
      "type": "boolean",
      "title": "Allow confirmed mutations",
      "description": "Permit mutation execution only when the tool call explicitly confirms the exact action. Disable to refuse all mutations.",
      "default": true,
      "required": false
    }
  },
  "compatibility": {
    "platforms": [
      "darwin",
      "win32",
      "linux"
    ],
    "runtimes": {
      "node": ">=22"
    }
  }
}
